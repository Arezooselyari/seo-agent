# ============================================================
# راهنمای تنظیمات — این فایل را به .env کپی کن
# مقادیر واقعی را در .env بنویس؛ این فایل را می‌توانی به دیگران بدهی
# فایل .env را هرگز به کسی ندهید و در گیت قرار ندهید
# ============================================================


# ──────────────────────────────────────────
# ۱) هوش مصنوعی — Gemini (رایگان، توصیه‌شده)
# ──────────────────────────────────────────
# مرحله ۱: به https://aistudio.google.com/apikey برو
# مرحله ۲: «Create API Key» را بزن
# مرحله ۳: کلید را اینجا کپی کن
GEMINI_API_KEY=

# Claude (اختیاری — فقط اگر در config.yaml مدل Claude انتخاب کردی)
# از: https://console.anthropic.com
ANTHROPIC_API_KEY=


# ──────────────────────────────────────────
# ۲) تلگرام — برای دریافت مقاله و کنترل ربات
# ──────────────────────────────────────────

# توکن ربات:
# مرحله ۱: در تلگرام @BotFather را پیدا کن
# مرحله ۲: /newbot را بزن
# مرحله ۳: نام ربات را بنویس (مثلاً: MyAIBot)
# مرحله ۴: توکن نمایش‌داده‌شده را اینجا کپی کن (شکل: 1234567890:AAFxxx...)
TELEGRAM_BOT_TOKEN=

# آیدی عددی چت خودت:
# مرحله ۱: در تلگرام @userinfobot را پیدا کن و /start بزن
# مرحله ۲: عدد «Id» را کپی کن (مثلاً: 70362663)
TELEGRAM_CHAT_ID=

# تلگرام دوم (اختیاری):
# اگر می‌خواهی مقاله به یک تلگرام/کانال دوم هم برود، این دو را پر کن.
# توکن یک ربات دیگر از @BotFather و chat id مقصد از @userinfobot.
# خالی بگذار اگر فقط یک مقصد می‌خواهی.
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=


# ──────────────────────────────────────────
# ۳) عکس استوک — Pexels (کاملاً رایگان)
# ──────────────────────────────────────────
# مرحله ۱: به https://www.pexels.com/api/ برو
# مرحله ۲: «Your API Key» را کپی کن (بدون نیاز به پرداخت)
PEXELS_API_KEY=


# ──────────────────────────────────────────
# ۴) دیتابیس — Supabase (پلن رایگان کافی است)
# ──────────────────────────────────────────
# مرحله ۱: در https://supabase.com حساب بساز
# مرحله ۲: «New Project» بساز (نام و رمز انتخاب کن)
# مرحله ۳: صبر کن تا project آماده شود (~۲ دقیقه)
# مرحله ۴: به Project Settings > API برو
#   - «Project URL» را در SUPABASE_URL کپی کن
#   - زیر «Project API Keys» گزینه‌ی «service_role» را کپی کن (نه anon!)
# مرحله ۵: به SQL Editor برو و محتوای فایل migrations/001_init.sql را اجرا کن
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=


# ──────────────────────────────────────────
# ۵) وردپرس — برای انتشار خودکار مقاله
# ──────────────────────────────────────────
# اگر Wordfence نصب است، ابتدا در Wordfence > Login Security
# گزینه‌ی «Disable Application Passwords» را غیرفعال کن
#
# سپس در وردپرس: Users > Profile > Application Passwords
# یک رمز جدید بساز و اینجا بنویس (با فاصله‌ها، مثل: abcd efgh ijkl mnop)
WP_URL=https://your-site.com
WP_USER=your_wordpress_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
