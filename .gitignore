# secrets — never commit
# نکته: الگوهای بدونِ ‎/ در هر پوشه‌ای مطابقت می‌کنند، پس زیرپوشه‌ها هم پوشش دارند.
.env
**/.env
botsecret.txt
botdomain.txt
botadminkey.txt
adminkey.txt
domain.txt
*secret*.txt
*adminkey*.txt
_backups/

# python
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc

# databases (binary, changes constantly — see _backups/ for snapshots)
*.db

# logs / cache
*.log
agent_log.txt
logs/
**/logs/
cache/
**/__pycache__/

# node
node_modules/

# مقاله‌های تولیدشده — خروجی‌اند نه کد. با هر اجرا زیاد می‌شوند و ریپو را باد
# می‌کنند؛ منبعِ حقیقتشان دیتابیس (agent.db) است، نه گیت.
# استثنا: فایل‌های نمونه‌ی دمو که سرویسِ عمومی به آن‌ها تکیه دارد.
outputs/
seo-agent/output/
content/
!demo/library/**
!seo-agent/demo/**

# فضای کارِ Claude (worktreeهای موقت)
.claude/
**/.claude/

# خروجیِ گذرای هر اجرا (هر بار بازنویسی می‌شود — ارزشِ تاریخچه ندارد)
