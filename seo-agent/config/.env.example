# این فایل را به .env تغییر نام بده و مقادیر واقعی را وارد کن

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# تلگرام (از BotFather بساز)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# ایمیل (اختیاری — اگر approval_channel = email یا both)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password-here
EMAIL_TO=you@example.com

# تصاویر
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# وردپرس (Application Password از پروفایل کاربری وردپرس)
WP_URL=https://your-site.com
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
