[Unit]
Description=Persian RAG Chatbot (FastAPI)
After=network.target

[Service]
Type=simple
User=chatbot
Group=chatbot
WorkingDirectory=/opt/chatbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/chatbot/venv/bin/uvicorn chatbot.app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
