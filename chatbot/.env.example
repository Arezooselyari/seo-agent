# ============================================================
# تنظیمات چت‌بات — این فایل را به .env کپی کن
# این .env کاملاً مستقل از .env ریشه‌ی پروژه است (سرویس جدا روی VPS اجرا می‌شود)
# هرگز .env واقعی را در گیت قرار نده
# ============================================================


# ──────────────────────────────────────────
# ۱) Gemini — مغز چت‌بات (مکالمه + embedding)
# ──────────────────────────────────────────
# از https://aistudio.google.com/apikey بگیر
GEMINI_API_KEY=


# ──────────────────────────────────────────
# ۲) Supabase — همان پروژه‌ی Supabase ریشه (جدول‌های جدید)
# ──────────────────────────────────────────
# از Project Settings > API در داشبورد Supabase (همان مقادیر .env ریشه)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=


# ──────────────────────────────────────────
# ۳) تلگرام — بات عمومی *جدید* و جداگانه (به بات ادمین src/bot.py دست نزن)
# ──────────────────────────────────────────
# با @BotFather یک بات تازه بساز (/newbot)
CHATBOT_TELEGRAM_BOT_TOKEN=

# رشته‌ی تصادفی دلخواه — هنگام setWebhook فرستاده می‌شود و در هدر
# X-Telegram-Bot-Api-Secret-Token برمی‌گردد؛ جایگزین چک chat_id است
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# آیدی عددی چت ادمین برای اطلاع‌رسانی لیدهای جدید (با @userinfobot بگیر)
ADMIN_TELEGRAM_CHAT_ID=


# ──────────────────────────────────────────
# ۴) وردپرس — فقط خواندن محتوا برای RAG (نیاز به احراز هویت ندارد)
# ──────────────────────────────────────────
WP_URL=https://sagharnazari.ir


# ──────────────────────────────────────────
# ۵) ویجت — دامنه‌هایی که اجازه‌ی embed دارند (CORS)
# ──────────────────────────────────────────
# جدا‌شده با کاما، بدون اسلش انتهایی
WIDGET_ALLOWED_ORIGINS=https://sagharnazari.ir


# ──────────────────────────────────────────
# ۶) آدرس عمومی این سرویس (برای ثبت webhook تلگرام)
# ──────────────────────────────────────────
# لوکال: آدرس ngrok؛ production: https://chatbot.sagharnazari.ir
APP_BASE_URL=http://localhost:8000
